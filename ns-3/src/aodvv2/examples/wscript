## -*- Mode: python; py-indent-offset: 4; indent-tabs-mode: nil; coding: utf-8; -*-

def build(bld):
    obj = bld.create_ns3_program('aodvv2-example', ['aodvv2', 'internet', 'wifi', 'applications'])
    obj.env.append_value('CXXFLAGS', '-std=c++17')
    obj.source = 'aodvv2-example.cc'

    obj = bld.create_ns3_program('aodvv2-create-networks', ['aodvv2', 'internet', 'wifi', 'applications'])
    obj.env.append_value('CXXFLAGS', '-std=c++17')
    obj.source = 'aodvv2-create-networks.cc'

    obj = bld.create_ns3_program('aodvv2-paper-example', ['aodvv2', 'aodv', 'internet', 'wifi', 'applications'])
    obj.env.append_value('CXXFLAGS', '-std=c++17')
    obj.source = 'aodvv2-paper-example.cc'
